{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licita.local/schemas/corpus_process.v0.1.0.json",
  "title": "Manifesto de processo do corpus",
  "description": "Metadados externos ao ProcurementProcess. Registros históricos podem conter apenas ETP/TR; novas coletas usam a cadeia completa ETP/TR/EDITAL/CONTRATO.",
  "type": "object",
  "required": [
    "processo_id",
    "numero_controle_pncp",
    "orgao",
    "compra",
    "objeto",
    "categoria_objeto",
    "perfil_id",
    "perfil_status",
    "perfil_inicial",
    "scope_status",
    "policy_version",
    "collection_policy_version",
    "cadeia",
    "documentos"
  ],
  "properties": {
    "processo_id": {
      "type": "string",
      "minLength": 1
    },
    "numero_controle_pncp": {
      "type": "string",
      "minLength": 1
    },
    "orgao": {
      "type": "object",
      "required": [
        "cnpj",
        "esfera"
      ],
      "properties": {
        "cnpj": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "esfera": {
          "enum": [
            "F",
            "E",
            "D",
            "M"
          ],
          "description": "Esfera do ente. Deixou de restringir o perfil (F/E/D/M valem), mas continua fechada e obrigatória: sem esfera conhecida não há prova de ente público sob o regime."
        }
      },
      "additionalProperties": true
    },
    "compra": {
      "type": "object",
      "required": [
        "modalidade_id",
        "instrumento_convocatorio_codigo",
        "amparo_legal_codigo",
        "amparo_legal_nome"
      ],
      "properties": {
        "modalidade_id": {
          "const": 6
        },
        "instrumento_convocatorio_codigo": {
          "const": 1
        },
        "amparo_legal_codigo": {
          "const": 1
        },
        "amparo_legal_nome": {
          "type": "string",
          "pattern": "14[.]133/2021"
        }
      },
      "additionalProperties": true
    },
    "objeto": {
      "type": "string",
      "minLength": 1
    },
    "categoria_objeto": {
      "type": "string",
      "minLength": 1
    },
    "perfil_id": {
      "const": "PUBLICO_14133_PREGAO_ELETRONICO_BENS"
    },
    "perfil_status": {
      "enum": [
        "SUPPORTED",
        "FORA_DO_PERFIL"
      ]
    },
    "perfil_inicial": {
      "enum": [
        "SUPPORTED",
        "FORA_DO_PERFIL"
      ]
    },
    "scope_status": {
      "enum": [
        "SUPPORTED",
        "OUT_OF_SCOPE"
      ]
    },
    "policy_version": {
      "enum": [
        "4-municipal-historical-ocr",
        "5-todas-esferas-historical-ocr",
        "6-cadeia-completa-todas-esferas",
        "7-cadeia-completa-documentos-utilizaveis",
        "8-cadeia-completa-documentos-utilizaveis"
      ]
    },
    "collection_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "cadeia": {
      "type": "object",
      "required": [
        "ETP",
        "TR"
      ],
      "properties": {
        "DFD": {
          "type": "array",
          "maxItems": 0
        },
        "ETP": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "TR": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "EDITAL": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Elo opcional da cadeia. Ausente na maioria dos entes; quando publicado, entra no lote e é validado como os demais."
        },
        "CONTRATO": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Elo opcional da cadeia. Ausente na maioria dos entes; quando publicado, entra no lote e é validado como os demais."
        },
        "PESQUISA_PRECOS": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "documentos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contratos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope_status": {
            "const": "SUPPORTED"
          }
        },
        "required": [
          "scope_status"
        ]
      },
      "then": {
        "properties": {
          "perfil_status": {
            "const": "SUPPORTED"
          },
          "perfil_inicial": {
            "const": "SUPPORTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope_status": {
            "const": "OUT_OF_SCOPE"
          }
        },
        "required": [
          "scope_status"
        ]
      },
      "then": {
        "properties": {
          "perfil_status": {
            "const": "FORA_DO_PERFIL"
          },
          "perfil_inicial": {
            "const": "FORA_DO_PERFIL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "collection_policy_version": {
            "enum": [
              "6-cadeia-completa-todas-esferas",
              "8-cadeia-completa-documentos-utilizaveis"
            ]
          }
        },
        "required": [
          "collection_policy_version"
        ]
      },
      "then": {
        "properties": {
          "cadeia": {
            "required": [
              "ETP",
              "TR",
              "EDITAL",
              "CONTRATO"
            ],
            "properties": {
              "EDITAL": {
                "minItems": 1,
                "maxItems": 1
              },
              "CONTRATO": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          "documentos": {
            "minItems": 4,
            "maxItems": 4
          },
          "contratos": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "numero_controle_pncp",
                "numero_controle_pncp_compra",
                "criterio_vinculo"
              ],
              "properties": {
                "numero_controle_pncp": {
                  "type": "string",
                  "minLength": 1
                },
                "numero_controle_pncp_compra": {
                  "type": "string",
                  "minLength": 1
                },
                "criterio_vinculo": {
                  "const": "numeroControlePncpCompra"
                }
              }
            }
          }
        },
        "required": [
          "contratos"
        ]
      }
    }
  ],
  "additionalProperties": true
}
