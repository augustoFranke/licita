{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licita.local/schemas/corpus_process.v0.1.0.json",
  "title": "Manifesto de processo do corpus municipal",
  "description": "Metadados externos ao ProcurementProcess para o perfil municipal exclusivo.",
  "type": "object",
  "required": [
    "processo_id",
    "numero_controle_pncp",
    "orgao",
    "compra",
    "objeto",
    "categoria_objeto",
    "perfil_id",
    "perfil_status",
    "perfil_inicial",
    "scope_status",
    "policy_version",
    "collection_policy_version",
    "cadeia",
    "documentos"
  ],
  "properties": {
    "processo_id": {"type": "string", "minLength": 1},
    "numero_controle_pncp": {"type": "string", "minLength": 1},
    "orgao": {
      "type": "object",
      "required": ["cnpj", "esfera"],
      "properties": {
        "cnpj": {"type": "string", "pattern": "^[0-9]{14}$"},
        "esfera": {"const": "M"}
      },
      "additionalProperties": true
    },
    "compra": {
      "type": "object",
      "required": [
        "modalidade_id",
        "instrumento_convocatorio_codigo",
        "amparo_legal_codigo",
        "amparo_legal_nome"
      ],
      "properties": {
        "modalidade_id": {"const": 6},
        "instrumento_convocatorio_codigo": {"const": 1},
        "amparo_legal_codigo": {"const": 1},
        "amparo_legal_nome": {
          "type": "string",
          "pattern": "14[.]133/2021"
        }
      },
      "additionalProperties": true
    },
    "objeto": {"type": "string", "minLength": 1},
    "categoria_objeto": {"type": "string", "minLength": 1},
    "perfil_id": {"const": "MUNICIPAL_14133_PREGAO_ELETRONICO_BENS"},
    "perfil_status": {"enum": ["SUPPORTED", "FORA_DO_PERFIL"]},
    "perfil_inicial": {"enum": ["SUPPORTED", "FORA_DO_PERFIL"]},
    "scope_status": {"enum": ["SUPPORTED", "OUT_OF_SCOPE"]},
    "policy_version": {"const": "4-municipal-historical-ocr"},
    "collection_policy_version": {"type": "string", "minLength": 1},
    "cadeia": {
      "type": "object",
      "required": ["ETP", "TR"],
      "properties": {
        "DFD": {"type": "array", "maxItems": 0},
        "ETP": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "TR": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "EDITAL": {"type": "array", "maxItems": 0},
        "CONTRATO": {"type": "array", "maxItems": 0},
        "PESQUISA_PRECOS": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    },
    "documentos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope_status": {"const": "SUPPORTED"}}, "required": ["scope_status"]},
      "then": {
        "properties": {
          "perfil_status": {"const": "SUPPORTED"},
          "perfil_inicial": {"const": "SUPPORTED"}
        }
      }
    },
    {
      "if": {"properties": {"scope_status": {"const": "OUT_OF_SCOPE"}}, "required": ["scope_status"]},
      "then": {
        "properties": {
          "perfil_status": {"const": "FORA_DO_PERFIL"},
          "perfil_inicial": {"const": "FORA_DO_PERFIL"}
        }
      }
    }
  ],
  "additionalProperties": true
}
